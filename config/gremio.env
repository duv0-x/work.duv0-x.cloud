# Configuración de la instancia work.duv0-x.cloud (sin secretos). pi/provision.sh la instala en /gremio/gremio.env.
GREMIO_DATA_DIR=/gremio/data
GREMIO_ADDR=127.0.0.1:8081
# Permanentes: la instancia ya federa como @root@duv0-x.cloud (ADR-001 de gremio).
GREMIO_HOST=https://work.duv0-x.cloud
GREMIO_ACCOUNT_DOMAIN=duv0-x.cloud
# Login del panel (ADR-009 de gremio) por Resend. El plan gratis tiene un solo dominio: el de papiro.
# La clave (una API key de Resend con "Sending access" solo a papiro.duv0-x.cloud) va en /gremio/secrets.env.
GREMIO_SMTP_HOST=smtp.resend.com
GREMIO_SMTP_PORT=465
GREMIO_SMTP_USERNAME=resend
GREMIO_SMTP_FROM=Gremio <gremio@papiro.duv0-x.cloud>
