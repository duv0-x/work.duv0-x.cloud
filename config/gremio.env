# Configuración de la instancia work.duv0-x.cloud (sin secretos). pi/provision.sh la instala en /gremio/gremio.env.
GREMIO_DATA_DIR=/gremio/data
GREMIO_ADDR=127.0.0.1:8081
# Permanentes: la instancia ya federa como @root@duv0-x.cloud (ADR-001 de gremio).
GREMIO_HOST=https://work.duv0-x.cloud
GREMIO_ACCOUNT_DOMAIN=duv0-x.cloud
